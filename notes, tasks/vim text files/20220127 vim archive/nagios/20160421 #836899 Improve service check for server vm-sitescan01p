define service{
    use                     generic-service
    host_name               vm-sitescan01p
    service_description     CPU Load
    check_command           check_nt!CPULOAD!-l 5,85,90
    notifications_enabled   1
    notification_options    w,u,c,r #   I suppose that this option must be defined here. It's garantee that all not needed notification will be send to empty-group.
    flap_detection_enabled  0   #   I don't want here and now working flapping. But in other cases it would be used if it needs.
    contact_groups          empty-group
    notification_interval   60  #   Send notification to nobody (epty-group) every 60 minutes.
}
define serviceescalation{
    host_name               vm-sitescan01p
    service_description     CPU Load
    contacts                cards_24x7_email,fraud_acquiring_email,paym_acquiring_email
    contact_groups          empty-group
    first_notification      3   #   Here I suppose that the first real notification will be send after 3 hours of service critical state.
    last_notification       0
    notification_interval   60  #   Here I have no idea how often retransmit same notification. I define it as 60 minutes for example.
    escalation_period       24x7    #   As it was defined for this server by default. Other wishes was not received yet.
    escalation_options      c
}

