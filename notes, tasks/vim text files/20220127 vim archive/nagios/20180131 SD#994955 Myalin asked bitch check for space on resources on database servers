# You can install it over yum or pip

# Externel paramenters:
# $1 - METHOD: available post or get (ex: METHOD='POST')
# $2 - DATA: anything you like (ex: DATA='encashment')
# $3 - ENDPOINT: any URL you like (ex: ENDPOINT='http://vm-pr-atmapi01t:8888/api/monitoring/get_cassette_info')
# $4 - OK_STRING: a response string which we think is OK (for more information see https://wiki.tcsbank.ru/pages/viewpage.action?pageId=260184736)

# Path to jq utility
JQ='/usr/bin/jq'
CURL='/usr/bin/curl'
METHOD="$1"
DATA="$2"
ENDPOINT="$3"
OK_STRING="$4"

# Nagios exit codes
OK=0
CRITICAL=2
UNKNOWN=3

if [ ! -f "$JQ" ]; then
  echo "jq tool is not installed. Install it first!"
  exit 1
fi

if [ "$#" -ne 4 ]; then
  echo "Usage: $(basename $0) METHOD DATA ENDPOINT OK_STRING"
  exit $UNKNOWN
fi

res=$(curl -s -X $METHOD -H "Content-Type: application/json" --data $DATA $ENDPOINT | $JQ -r '.response')

if [ "$res" == "$OK_STRING" ]; then
  echo "OK Response: $res|res=1"
  exit $OK
else
  echo "CRITICAL Response: $res|res=0"
  exit $CRITICAL
fi
