#!/bin/bash
SOA_VERSION=`host -W 3 -t soa $2 $1| grep SOA | awk '{print $7}'`
RES=`host -W 3 -C $2 $1| grep -A1 Nameserver | tr '\n' ' ' | sed 's/Nameserver/\n/g' | sed '/^$/d' | tr ':' ' ' | awk '{printf("[%s]=%s ",$1,$8)}'`
eval "declare -A NS_VERSION=($RES)"

STATUS_OK=0
STATUS_WARNING=1
STATUS_CRITICAL=2
STATUS_UNKNOWN=3
EXIT_WARNING=0

for HOST in "${!NS_VERSION[@]}"
do
  if [[ ${SOA_VERSION} != ${NS_VERSION[$HOST]} ]] ; then
    echo WARNING - $HOST zone version is ${NS_VERSION[$HOST]}, SOA is ${SOA_VERSION}
    EXIT_WARNING=1
  fi
done

if [[ "$EXIT_WARNING" == "1" ]] ; then
  if [[ -f /tmp/check_dns_zone_version_fail.tmp ]] ; then
    if [[ "$(head -n 1 /tmp/check_dns_zone_version_fail.tmp)" < "`date +"%s"`" ]] ; then
      continue
    else
      exit $STATUS_CRITICAL
    fi
  else
    date -d "+1 hours" +"%s" > /tmp/check_dns_zone_version_fail.tmp
  fi
  exit $STATUS_WARNING
fi

if [[ -f /tmp/check_dns_zone_version_fail.tmp ]] ; then
  rm -f /tmp/check_dns_zone_version_fail.tmp
fi

echo OK - SOA version is ${SOA_VERSION}
exit $STATUS_OK
