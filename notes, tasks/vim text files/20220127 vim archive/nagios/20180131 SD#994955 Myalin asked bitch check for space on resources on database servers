  exit $STATUS_WARNING
elif [[ "${RESULT[0]}" -ne "200" ]]
then
  echo "CRITICAL - Response code is not 200: ${RESULT[0]} $PERFINFO"
  exit $STATUS_CRITICAL
elif [[ "${RESULT[0]}" -eq "200" && "${RESULT[1]}" -lt "500" ]]
then
  echo "CRITICAL - Response size less than 500: ${RESULT[1]} $PERFINFO"
  exit $STATUS_CRITICAL
elif [[ $(echo "5 < ${RESULT[2]}" | bc) -eq 1 ]]
then
  echo "CRITICAL - Response time is greather than 5s.: ${RESULT[2]} $PERFINFO"
