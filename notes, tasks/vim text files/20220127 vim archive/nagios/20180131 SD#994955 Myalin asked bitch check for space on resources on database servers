#!/bin/bash

# This script had been written in according SD#994955, made by Myalin Dmitry.
# I have a plan to replace standard check of disk space for nfs volumes to this script.
# Of course, will be replaced only checks with conditions, that fit to be replaced by this script.
# I'm talking about checks of disk space by its percents.

STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3

# Names of variables were adopted for parameters of check_disk nrpe plugin for nagios.
HOST_ADDRESS="$1"
NRPE_COMMAND="$2"
WARNING_IN_PERCENT="$3"
CRITICAL_IN_PERCENT="$4"
WARNING_IN_MEGABYTES="$5"
CRITICAL_IN_MEGABYTES="$6"
PATH_TO_PARTITION="$7"

check_disk_percent="$(/usr/local/nagios/libexec/check_nrpe -t 60 -H $HOST_ADDRESS -c $NRPE_COMMAND -a $WARNING_IN_PERCENT $CRITICAL_IN_PERCENT $PATH_TO_PARTITION)"
let check_disk_percent_exit_code=$?

check_disk_megabytes="$(/usr/local/nagios/libexec/check_nrpe -t 60 -H $HOST_ADDRESS -c $NRPE_COMMAND -a $WARNING_IN_MEGABYTES $CRITICAL_IN_MEGABYTES $PATH_TO_PARTITION)"
let check_disk_megabytes_exit_code=$?

# echo -e "check_disk_percent: ${check_disk_percent}\nexit code: ${check_disk_percent_exit_code}"
# echo -e "check_disk_megabytes: ${check_disk_megabytes}\nexit code: ${check_disk_megabytes_exit_code}"

if [ ${check_disk_percent_exit_code} -eq $STATE_WARNING -a ${check_disk_megabytes_exit_code} -eq $STATE_WARNING ]
    then
        # echo "It's a warning state"
        echo "${check_disk_percent}"
        exit $STATE_WARNING
elif [ ${check_disk_percent_exit_code} -eq $STATE_CRITICAL -a ${check_disk_megabytes_exit_code} -eq $STATE_CRITICAL ]
    then
        #echo "It's a critical state"
        echo "${check_disk_percent}"
        exit $STATE_CRITICAL
elif [ ${check_disk_percent_exit_code} -eq $STATE_UNKNOWN -o ${check_disk_megabytes_exit_code} -eq $STATE_UNKNOWN ]
    then
        # echo "It's unknown state of check"
        echo "${check_disk_percent}"
        exit $STATE_UNKNOWN
else
    # echo "There is no reasons to worry."
    echo "DISK OK - $(echo \"${check_disk_percent}\" | sed -e 's/\(.*\) - \(.*\)/\2/')"
    exit $STATE_OK
fi
