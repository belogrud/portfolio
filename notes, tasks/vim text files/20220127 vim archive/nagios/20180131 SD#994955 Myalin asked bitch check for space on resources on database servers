  echo "OK $PERFINFO"
  exit $STATUS_OK
elif [[ "${RESULT[0]}" -eq "200" && "${RESULT[1]}" -gt "500" && $(echo "1 < ${RESULT[2]}" | bc) -eq 1 && $(echo "5 > ${RESULT[2]}" | bc) -eq 1 ]]
then
