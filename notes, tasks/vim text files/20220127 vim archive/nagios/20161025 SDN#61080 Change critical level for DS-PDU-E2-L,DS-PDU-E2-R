#!/bin/bash

STATE_OK=0
STATE_WARN=1
STATE_CRIT=2
STATE_UNKNOWN=3


snmp=`/usr/lib64/nagios/plugins/check_snmp $@`

STATE=$?

if [ $STATE -ge $STATE_UNKNOWN ] ; then
    echo "SNMP problem - No data received from host"
    exit $STATE_UNKNOWN
fi

val=`echo $snmp|cut -d" " -f4`
val1=${val//\*/}
if [[ $val1 -lt 0 || "$val1" == "No" ]]; then
  ####No Such Object available on this agent at this OID
  echo "No valid data returned"
  exit $STATE_UNKNOWN
fi

echo ${snmp//\*/}|awk '{ $4 = $4 / 10; split($6,a,"="); $6 = a[1] "=" (a[2] / 10); print $0 }'
exit $STATE

