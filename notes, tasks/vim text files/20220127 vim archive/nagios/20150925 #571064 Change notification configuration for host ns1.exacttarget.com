Текущая запись на странице «таблица по оповещениям из Nagios», видимо нуждается в корректировке.
https://wiki.tcsbank.ru/pages/viewpage.action?pageId=23169327





Так выглядит на текущий момент настройка оповещений для этого хоста (сервиса).





С уважением,

Сергей Белогруд
Старший системный администратор


................................................................................
................................................................................

[bsv@vm-vol-nag01t vm-vol-nag01t]$ cat objects/contacts/colscadms.cfg
define contact{
        contact_name                    colscadms_email
        use                             generic-contact
        email                           colscadms@tinkoff.ru
}
[bsv@vm-vol-nag01t vm-vol-nag01t]$


[bsv@vm-vol-nag01t vm-vol-nag01t]$ find . -name *exacttarget*
./objects/external/ns2-exacttarget.cfg
./objects/external/ns1-exacttarget.cfg
[bsv@vm-vol-nag01t vm-vol-nag01t]$

#    contact_groups           empty-group
#    contacts                 a.leonov_email
#        check_period             8x5
#           notification_period             8x5


................................................................................
[bsv@vm-vol-nag01t vm-vol-nag01t]$ cat ./objects/external/ns1-exacttarget.cfg
define host{
        use                     linux-server
        host_name               ns1.exacttarget.com
        alias                   DNS Server ns1.exacttarget.com monitoring
        address                 ns1.exacttarget.com
        notes_url               http://servicedesk/fx/sd/ru.naumen.sd.published_jsp?uuid=svcallfs000080000jj60gm6h9a40054
        contacts                colscadms_email
}

define service{
        use                     generic-service
        host_name               ns1.exacttarget.com
        service_description     PING
        check_command           check_ping!200.0,20%!500.0,60%
        contacts                colscadms_email
}

#define service{
#        use                     generic-service
#        host_name               ns1.exacttarget.com
#        service_description     Check DNS Server ns1.exacttarget.com
#        check_command           check_dns!www.google.ru!ns1.exacttarget.com!!60
#        notifications_enabled   1
#}

[bsv@vm-vol-nag01t vm-vol-nag01t]$
