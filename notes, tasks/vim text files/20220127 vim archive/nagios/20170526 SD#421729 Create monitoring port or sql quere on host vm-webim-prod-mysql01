#!/bin/bash

SQL_QUERY_HOST='db-pg2-prod'
SQL_QUERY_PORT='1522'
SQL_QUERY_BASE='PG2'
SQL_QUERY_USER='tcs_monitor'
SQL_QUERY_PASSWORD='tcs_monitor1'

SQL_QUERY_DIR=/opt/TCS/scripts/nagios/plugins
SQL_QUERY_FILE=$SQL_QUERY_DIR/pg2/pg2-check_tcs_sme_check_paused_cain.sql

STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3

export ORACLE_HOME=/opt/oracle/products/11g/client
export PATH=$PATH:/$ORACLE_HOME/bin

RESULT=$(echo "exit" | sqlplus -s $SQL_QUERY_USER/$SQL_QUERY_PASSWORD@\"$SQL_QUERY_HOST:$SQL_QUERY_PORT/$SQL_QUERY_BASE\" @$SQL_QUERY_FILE)

if [ "$RESULT" = 0 ]; then
  echo "OK. Result=$RESULT | result=$RESULT"
  exit $STATE_OK
else
  echo "ERROR. Result=$RESULT | result=$RESULT"
  exit $STATE_CRITICAL
fi
