#!/bin/bash

STATE_OK=0
STATE_WARNING=1
STATE_CRITICAL=2
STATE_UNKNOWN=3


RESULT=$(/usr/bin/du -s /home/online/log | cut -f 1)

#WARNING=${WARNING:-$DEF_MIN}
#CRITICAL=${CRITICAL:-$DEF_MAX}

#RESULT=2000001

if [ "$RESULT" -lt 1900000 ]; then
  echo "LOG SIZE OK - count $RESULT | Count=$RESULT"
  exit $STATE_OK
elif [ "$RESULT" -ge 1900000 ]; then
  echo "LOG SIZE CRITICAL - count $RESULT | Count=$RESULT"
  exit $STATE_CRITICAL
else
  echo "UNKNOWN"
  exit $STATE_UNKNOWN
fi


