# install.pp

class simpana::install{
    $fileserver = 'repo-linux'
    $pname = 'simpana'
    $pversion = '11'
    $archname = '11_simpana_custom_unix'

package { 'wget':
            ensure => present,
}

exec {
      'get_archive':
        command   => "/usr/bin/wget http://${fileserver}/${pname}/${pversion}/${archname}.tar -O /tmp/${archname}.tar",
        logoutput => 'on_failure',
        require   => [ Package['wget'], ],
        unless    => ['test -f /usr/bin/simpana'],
        path      => ['/usr/bin', '/usr/sbin',],
}

exec {
      'extract_archive':
        command   => "tar -xf /tmp/${archname}.tar",
        logoutput => 'on_failure',
        creates   => '/tmp/pkg',
        cwd       => '/tmp',
        require   => Exec['get_archive'],
        unless    =>  ['test -f /usr/bin/simpana'],
        path      => ['/bin',],
}

exec {
      'install_simpana_agent':
        command   => 'bash silent_install -silent',
        logoutput => 'on_failure',
        cwd       => '/tmp/pkg',
        path      => ['/bin', '/usr/bin', '/usr/sbin', '/tmp/pkg',],
        creates   => '/usr/bin/simpana',
        require   => Exec['extract_archive'],
}
}
