#!/bin/bash

authstr="--cacert /var/lib/puppet/ssl/certs/ca.pem --cert /var/lib/puppet/ssl/certs/vm-vol-nag4-prod.tcsbank.ru.pem --key /var/lib/puppet/ssl/private_keys/vm-vol-nag4-prod.tcsbank.ru.pem --tlsv1 -s"

curl -s -X GET http://puppetdb:8080/v3/nodes | sed -e 's/[{}",]/''/g' |grep name|awk '{print $3}'|egrep -e "tcsbank|local" |grep -v '\\' > /tmp/notes/nodelist

mkdir -p /tmp/notes/puppet

while read node

do

curl -s -X GET http://puppetdb:8080/v3/nodes/$node/facts > /tmp/notes/$node
kernelrelease=`cat /tmp/notes/$node | sed -e 's/[{}",]/''/g' |egrep -B 1 -e "kernelrelease"|grep value |awk -F ":" '{print $2}'`
fqdn=`cat /tmp/notes/$node | sed -e 's/[{}",]/''/g' |egrep -B 1 -e "fqdn"|grep value |awk -F ":" '{print $2}'`
productname=`cat /tmp/notes/$node | sed -e 's/[{}",]/''/g' |egrep -B 1 -e ' productname'|grep value |awk -F ":" '{print $2}'`
serialnumber=`cat /tmp/notes/$node | sed -e 's/[{}",]/''/g' |egrep -B 1 -e ' serialnumber'|grep value |awk -F ":" '{print $2}'`
os=`cat /tmp/notes/$node | sed -e 's/[{}",]/''/g' |egrep -B 1 -e ' lsbdistdescription'|grep value |awk -F ":" '{print $2}'`

nodename=`echo $node |sed -s 's/\.tcsbank\.ru//g'`

echo > /tmp/notes/puppet/$nodename.txt
echo "----------------" >> /tmp/notes/puppet/$nodename.txt
echo "Puppet notes" >> /tmp/notes/puppet/$nodename.txt
echo "----------------" >> /tmp/notes/puppet/$nodename.txt
echo "host: $fqdn" >> /tmp/notes/puppet/$nodename.txt
echo "platform: $productname" >> /tmp/notes/puppet/$nodename.txt
echo "serial: $serialnumber" >> /tmp/notes/puppet/$nodename.txt
echo "os: $os" >> /tmp/notes/puppet/$nodename.txt
echo "kernel: $kernelrelease" >> /tmp/notes/puppet/$nodename.txt

echo "note for node $node writed"

done < /tmp/notes/nodelist
