................................................................................
................................................................................

#
#   Shinkarev said that accont on this ftp server creates exactly like it make for vm-ftp05 server, that was made by Aleksandrov Aleksey.
#   Some description how to do it was placed under this link: https://wiki.tcsbank.ru/pages/viewpage.action?pageId=42077242
#   Article name is "Добавление пользователей на vm-ftp05".
#

[root@vm-ftp01 ~]# mkdir /opt/ftp/media_forensic
[root@vm-ftp01 ~]# chown virtual:virtual !$
chown virtual:virtual /opt/ftp/media_forensic
[root@vm-ftp01 ~]# chmod 0755 !$
chmod 0755 /opt/ftp/media_forensic
[root@vm-ftp01 ~]#


media_forensic_read
Ye*aqu7oth
media_forensic_write
uX2quah&v9


[root@vm-ftp01 ~]# vim /etc/vsftpd/logins.txt
...
media_forensic_read
Ye*aqu7oth
media_forensic_write
uX2quah&v9

[root@vm-ftp01 ~]# cp /etc/vsftpd_user_conf/{apvd.abartashov,media_forensic_read}
[root@vm-ftp01 ~]# cp /etc/vsftpd_user_conf/{apvd.abartashov,media_forensic_write}

[root@vm-ftp01 ~]# vim /etc/vsftpd_user_conf/media_forensic_read
[root@vm-ftp01 ~]# vim /etc/vsftpd_user_conf/media_forensic_write

[root@vm-ftp01 ~]# cat /etc/vsftpd_user_conf/media_forensic_{read,write}
local_root=/opt/ftp/media_forensic
write_enable=NO
local_root=/opt/ftp/media_forensic
write_enable=YES
[root@vm-ftp01 ~]#


[root@vm-ftp01 ~]# cd /etc/vsftpd/
[root@vm-ftp01 vsftpd]# ll
total 44
drwxr-xr-x 2 root root  4096 Nov 20 17:02 cert
-rw------- 1 root root   125 Jul 24  2015 ftpusers
