total 20K
-rw-r--r-- 1 root root 41 Nov 18 12:59 apvd.abartashov
-rw-r--r-- 1 root root 42 Nov 18 13:00 n.shtanko
-rw-r--r-- 1 root root 42 Nov 18 13:00 s.goncharov
-rw-r--r-- 1 root root 46 Jan 29 10:45 sravni.ru
-rw-r--r-- 1 root root 47 Jan 29 10:45 sravni.ru_rw
