$ModLoad imuxsock.so    # provides support for local system logging (e.g. via logger command)
$ModLoad imklog.so      # provides kernel logging support (previously done by rklogd)


$MainMsgQueueSize 4000000
$ActionFileDefaultTemplate RSYSLOG_TraditionalFileFormat
$ActionQueueDequeueBatchSize 1000
$MainMsgQueueDequeueBatchSize 200000





if \
        $fromhost-ip == '127.0.0.1' \
        and \
               $syslogseverity <= '6' \
        and ( \
                        $syslogfacility-text != 'mail' \
                and \
                        $syslogfacility-text != 'authpriv' \
                and \
                        $syslogfacility-text != 'cron' \
        ) \
then    /var/log/messages

if \
        $fromhost-ip == '127.0.0.1' \
                and \
        $syslogfacility-text == 'authpriv' \
then    /var/log/secure

if \
        $fromhost-ip == '127.0.0.1' \
                and \
        $syslogfacility-text == 'mail' \
then    -/var/log/maillog


if \
        $fromhost-ip == '127.0.0.1' \
                and \
        $syslogfacility-text == 'cron' \
then    /var/log/cron


if \
        $fromhost-ip == '127.0.0.1' \
                and \
        (\
                $syslogfacility-text == 'uucp' \
                        or \
                $syslogfacility-text == 'news' \
        )\
                and \
        $syslogseverity-text == 'crit' \
then    /var/log/spooler

if \
        $fromhost-ip == '127.0.0.1' \
                and \
        $syslogfacility-text == 'local7' \
then    /var/log/boot.log

$template DYNmessages,"/var/log/servers/%HOSTNAME%/%$YEAR%/%$MONTH%/%$DAY%/messages"
$template DYNsecure,"/var/log/servers/%HOSTNAME%/%$YEAR%/%$MONTH%/%$DAY%/secure"
$template DYNmaillog,"/var/log/servers/%HOSTNAME%/%$YEAR%/%$MONTH%/%$DAY%/maillog"
