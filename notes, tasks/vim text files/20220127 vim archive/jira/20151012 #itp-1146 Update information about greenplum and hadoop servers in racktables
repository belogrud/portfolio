select o.id ,o.asset_no , a1.string_value as 'S/N', a3.string_value as 'FQDN', a10003.string_value as 'P/N'
from Object  o
left join AttributeValue  a1 on o.id=a1.object_id and a1.attr_id=1
left join AttributeValue  a3 on o.id=a3.object_id and a3.attr_id=3
left join AttributeValue  a10003 on o.id=a10003.object_id and a10003.attr_id=10003 where o.name like '%ds-gp-dev%';


#   Same as above, but looks more understandable.
select
 syntetic.id,
 syntetic.name,
 syntetic_attr_3.string_value as 'FQDN',
 syntetic.asset_no,
 syntetic_attr_1.string_value as 'S/N',
 syntetic_attr_10003.string_value as 'P/N'
from Object  syntetic
left join AttributeValue  syntetic_attr_1 on syntetic.id=syntetic_attr_1.object_id and syntetic_attr_1.attr_id=1
