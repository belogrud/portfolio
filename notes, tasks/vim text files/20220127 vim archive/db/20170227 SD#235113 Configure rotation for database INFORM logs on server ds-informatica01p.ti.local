[root@ds-db01-prod ~]#
[root@ds-db01-prod ~]# cat /opt/oracle/scripts/archive_old_files.sh
FILE_LIST=/tmp/files_to_archive.txt
BACKUP_FILE=`date +/opt/oracle/backup/%Y-%m-%d_%H-%M.tar`

# DELETE OLDER THAN MONTH
find /opt/oracle/diag/rdbms/*/*/trace/ -maxdepth 1 -mtime +30 -type f -name "alert_*.log.*" > $FILE_LIST
find /opt/oracle/diag/tnslsnr/*/*/trace/ -maxdepth 1 -mtime +30 -type f -name "*1522.log.*" >> $FILE_LIST

# DELETE OLDER THAN 10 DAYS
find /opt/oracle/diag/rdbms/*/*/alert/ -maxdepth 1 -mtime +10 -type f -name "log_*.xml" >> $FILE_LIST
find /opt/oracle/diag/tnslsnr/*/*/alert/ -maxdepth 1 -mtime +10 -type f -name "log_*.xml" >> $FILE_LIST
find /opt/oracle/admin/*/adump/ -maxdepth 1 -type f -mtime +10 -type f -name "*.aud" >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/incident/incdir_* -maxdepth 1 -mtime +10 -type f >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/stage/ -maxdepth 1 -mtime +10 -type f -name "*.stg"  >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/trace/ -maxdepth 2 -mtime +10 -type f -name "*_ora_*.tr?" >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/trace/ -maxdepth 2 -mtime +10 -type f -name "*_j???_*.tr?" >> $FILE_LIST

# DELETE OLDER THAN 7 DAYS
# find /opt/oracle/admin/*/bdump/ -maxdepth 1 -type f -mtime +7 -type f -name "*_ora_*.tr?" >> $FILE_LIST

tar -cf $BACKUP_FILE -T $FILE_LIST --remove-files
gzip $BACKUP_FILE
rm -f $FILE_LIST
[root@ds-db01-prod ~]#

