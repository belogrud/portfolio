Текущее содержимое конфигурационных файлов и файлов-скриптов, учавствующих в ротации логов, нижеследующее.
[11:36:02 root@ds-informatica01p.ti.local ~] # cat /opt/oracle/scripts/rotate_logs.sh
#!/bin/sh
/usr/sbin/logrotate /etc/logrotate-oracle.conf
EXITVALUE=$?
if [ $EXITVALUE != 0 ]; then
    /usr/bin/logger -t logrotate "ALERT exited abnormally with [$EXITVALUE]"
fi
exit 0
[11:42:48 root@ds-informatica01p.ti.local ~] #
[11:42:48 root@ds-informatica01p.ti.local ~] # cat /etc/logrotate-oracle.conf
/opt/oracle/diag/rdbms/inform_p/INFORM/trace/alert_INFORM.log {
        rotate 60
        daily
        create 0640 oracle oinstall
        copytruncate
}
/opt/oracle/diag/tnslsnr/ds-informatica01p/inform_prod_1522//trace/inform_prod_1522.log {
        rotate 60
        daily
        create 0640 oracle oinstall
        copytruncate
}
[11:43:04 root@ds-informatica01p.ti.local ~] #
[11:43:04 root@ds-informatica01p.ti.local ~] # cat /opt/oracle/scripts/archive_old_files.sh
FILE_LIST=/tmp/files_to_archive.txt
BACKUP_FILE=`date +/opt/oracle/backup/%Y-%m-%d_%H-%M.tar`
# DELETE OLDER THAN MONTH
find /opt/oracle/diag/rdbms/*/*/trace/ -maxdepth 1 -mtime +30 -type f -name "alert_*.log.*" > $FILE_LIST
find /opt/oracle/diag/tnslsnr/*/*/trace/ -maxdepth 1 -mtime +30 -type f -name "*1522.log.*" >> $FILE_LIST
# DELETE OLDER THAN 10 DAYS
find /opt/oracle/diag/rdbms/*/*/alert/ -maxdepth 1 -mtime +10 -type f -name "log_*.xml" >> $FILE_LIST
find /opt/oracle/diag/tnslsnr/*/*/alert/ -maxdepth 1 -mtime +10 -type f -name "log_*.xml" >> $FILE_LIST
find /opt/oracle/admin/*/adump/ -maxdepth 1 -type f -mtime +10 -type f -name "*.aud" >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/incident/incdir_* -maxdepth 1 -mtime +10 -type f >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/stage/ -maxdepth 1 -mtime +10 -type f -name "*.stg"  >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/trace/ -maxdepth 2 -mtime +10 -type f -name "*_ora_*.tr?" >> $FILE_LIST
find /opt/oracle/diag/rdbms/*/*/trace/ -maxdepth 2 -mtime +10 -type f -name "*_j???_*.tr?" >> $FILE_LIST
# DELETE OLDER THAN 7 DAYS
# find /opt/oracle/admin/*/bdump/ -maxdepth 1 -type f -mtime +7 -type f -name "*_ora_*.tr?" >> $FILE_LIST
tar -cf $BACKUP_FILE -T $FILE_LIST --remove-files
gzip $BACKUP_FILE
rm -f $FILE_LIST
[11:43:19 root@ds-informatica01p.ti.local ~] #
[11:43:19 root@ds-informatica01p.ti.local ~] # cat /etc/logrotate.d/oracle-by-size
/var/log/oracle.log
{
    missingok
    notifempty
    rotate 140
    size 1G
    compress
    sharedscripts
    postrotate
        /bin/kill -HUP `cat /var/run/syslogd.pid 2> /dev/null` 2> /dev/null || true
    endscript
}
