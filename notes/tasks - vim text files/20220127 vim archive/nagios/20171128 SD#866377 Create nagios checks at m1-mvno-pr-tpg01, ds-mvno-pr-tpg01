#!/bin/bash

if [ -z "$1" -o -z "$2" ]; then
  echo "Usage: $(basename $0) server_ip request.xml"
  exit 3
fi

SERVER=$1
REQUETS=$2

RESULT=$(curl -s -i -X POST -H 'Content-Type: text/xml;charset=UTF-8' -H 'SOAPAction: "http://www.mfms.ru/tcsbank/pg/pif/provider-service/getProviderGroupList"' \
 --data-binary @$REQUETS http://$SERVER:3306/services/ProviderServiceService | head -n1 | cut -d' ' -f2)

if [ "$RESULT" = '200' ]; then
        echo "OK: Address $SERVER, HTTP response: $RESULT"
        exit 0
else
        echo "ERROR: Address $SERVER, HTTP response: ${RESULT:-UNKNOWN}"
        exit 2
fi
