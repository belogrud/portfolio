    Improved two scripts to avoid duplicate run it via cron if previous process was not finish its work. Multiple running scripts consume lot enouth resources and significantly increase nagios latency.

diff --git a/nagios_restore_not_persistant_comments.sh b/nagios_restore_not_persistant_comments.sh
index 9f4edfd..58ba7ca 100755
--- a/nagios_restore_not_persistant_comments.sh
+++ b/nagios_restore_not_persistant_comments.sh
@@ -1,5 +1,46 @@
 #!/bin/bash

+LOCKFILE="/var/lock/subsys/$(basename $BASH_SOURCE)"
+
+if [ -e ${LOCKFILE} ]
+    then
+        #   If LOCKFILE exists, we suppose that possible more than one copy of this script is running.
+
+        this_script_name="$(basename $BASH_SOURCE)"
+        this_script_pid="$$"
+
+        let count_of_script_pids=0
+
+        for these_scripts_pids in $(pgrep -f "${this_script_name}")
+            do
+                if [ ${these_scripts_pids} -ne ${this_script_pid} ]
+                    then
+                        ((count_of_script_pids++))
+                        #   Let's try to kill other running exemplars of this scripts.
+                        kill -9 ${these_scripts_pids}
+                fi
+            done
+
+        # To correct start this script next time, let's try to remove LOCKFILE.
+        if [ ${count_of_script_pids} -gt 0 ]
+            then
+                #   This means that was found several running copies of this script.
+                #   We don't know how successfully we killed them.
+                #   Now we exiting with error code.
+                #   Next time this script start if there are no found duplicates and then this script will remove LOCKFILE.
+                #   And only next time if LOCKFILE was removed successful, this script do its job.
+                exit 1
+            else
+                #   We suppose that even not found running copies of this script, we don't do other then just try to remove LOCKFILE.
+                #   This is just to be safe from any cases.
+                if [ -e ${LOCKFILE} ] ; then rm -f ${LOCKFILE} ; fi
+                exit 2
+        fi
+
+    else
+        touch ${LOCKFILE}
+fi
+
 let index=0

