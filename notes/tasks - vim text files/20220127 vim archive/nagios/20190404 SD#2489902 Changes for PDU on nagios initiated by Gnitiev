#!/bin/bash

for var_host_name in $(pynag list host_name where object_type=host and host_name__contains="DS-PDU" --quiet ) ;
    do
        var_host_name_address="$(pynag list address where object_type=host and host_name="${var_host_name}" --quiet)"
        printf "${var_host_name}\t"
        # var_host_name_address="$(pynag list address where object_type=host and host_name="DS-PDU-B1-R" --quiet)"
        output="$(host ${var_host_name_address} 2>&1)"
        if [ $? -eq 0 ] ;
            then
                var_dns_name_of_host_name_address="$(echo ${output} | awk '{print $5}' | sed -e 's/^\(.*\)\.$/\1/g')"
                echo "${var_dns_name_of_host_name_address}"
                pynag update set address="${var_dns_name_of_host_name_address}" where object_type=host and host_name="${var_host_name}" --quiet --force
            else
                echo "${var_dns_name_of_host_name_address}"
        fi
    done
