yum install sssd realm realmd krb5-workstation sssd-ad oddjob-mkhomedir vim authconfig man pam_krb5 nscd adcli
vi /etc/krb5.conf
adcli join -S tcsbank.ru -K /etc/krb5.keytab -U s.belogrud -O "OU=Unix,OU=Servers,DC=tcsbank,DC=ru" --os-name=RHEL --os-version 7.5 -W
authconfig --enablecache --enablesssd --enablesssdauth --smbsecurity=ads --smbworkgroup=TCSBANK --smbrealm=TCSBANK.RU --enablelocauthorize --enablemkhomedir --enablepamaccess --updateall
klist -kte
vi /etc/sssd/sssd.conf
chown root:root /etc/sssd/sssd.conf
chmod 600 /etc/sssd/sssd.conf
service sssd start
#	Below are Pavel's test. He tried to save hash to loging via ssh into active directory.
