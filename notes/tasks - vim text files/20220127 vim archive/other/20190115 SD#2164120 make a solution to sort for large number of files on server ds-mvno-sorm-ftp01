#!/bin/bash

shopt -s extglob

FTP_SRV='10.250.137.1'

SRC_DIR=/mnt/sorm_exchange/upload/
ARC_DIR=/mnt/sorm_exchange/archive/

abon_user=abon
abon_pass=CiRavRuQLGNmPYaz
dict_user=dict
dict_pass=d7w7yCObeHFJwQGf
pay_user=pay
pay_pass=mYkRa6dlIdepqBDZ
cdr_user=cdr
cdr_pass=IZvOVlfZexY2jnfO

LOGFILE=/opt/sorm3-logs/ftp-sorm3.log

abon_pattern='@(ABONENT_*.txt)'
pay_pattern='@(BANK_TRANSFER_*.txt|EXPRESS_CARD_TRANSFER_*.txt|TERMINAL_CHARGES_*.txt|CUSTOMER_CENTER_PAYMENT_*.txt|WITHDRAWALS_OTHER_PAYMENT_*.txt|TELEPHONE_CARD_PAYMENT_*.txt|TRANSFER_REMOVAL_BANK_PAYMENT_*.txt|UNDEFINED_PAYMENT_*.txt|TRANSFER_REMOVAL_BANK_CARD_PAYMENT_*.txt|ACCOUNT_BANK_PAYMENT_*.txt)'
dict_pattern='@(REGIONS_*.txt|ROAM_OPERATOR_*.txt|COMMUTATORS_*.txt|BUNCHES_*.txt|BUNCHES_MAP_*.txt|BASE_STATION_*.txt|BASE_STATION_ANTENNA_*.txt|BASE_STATION_WRL_*.txt|BASE_STATION_IP_*.txt|GATEWAYS_*.txt|IP_GATEWAY_*.txt|CONNECTION_TYPE_*.txt|SUPPLEMENTARY_SERVICE_*.txt|PAY_TYPE_*.txt|TERMINATION_TYPE_*.txt|IP_PLAN_*.txt|PHONE_PLAN_*.txt|DOC_TYPE_*.txt|IP_DATA_POINTS_*.txt|PHONE_SPECIAL_*.txt|MOBILE_PLAN_*.txt)'
cdr_pattern='@(CONNECTION_PSTN_*.txt|CONNECTION_GSM_*.txt|CONNECTION_PAGER_*.txt|CONNECTION_CDMA_*.txt|CONNECTION_AAA_*.txt|CONNECTION_VOIP_*.txt|CONNECTION_VOIP_GATEWAYS_*.txt)'

for RES in $(find $SRC_DIR -maxdepth 1 -type f ! -name '~*')
do
    FILENAME=$(basename $RES)
    FILESIZE=$(du -k $RES | awk '{print $1}')
    case $(basename $RES) in
        $abon_pattern)       lftp -c "open -u $abon_user,$abon_pass $FTP_SRV; put -O / $RES" && mv $RES $ARC_DIR && echo $(/bin/date +%D\ %H:%M:%S) INFO File $FILENAME $FILESIZE has been sent successfully>> $LOGFILE || echo $(/bin/date +%D\ %H:%M:%S) ERROR File $FILENAME $FILESIZE has not been sent >> $LOGFILE;;
        $cdr_pattern)        lftp -c "open -u $cdr_user,$cdr_pass $FTP_SRV; put -O / $RES" && mv $RES $ARC_DIR && echo $(/bin/date +%D\ %H:%M:%S) INFO File $FILENAME $FILESIZE has been sent successfully >> $LOGFILE || echo $(/bin/date +%D\ %H:%M:%S) ERROR File $FILENAME $FILESIZE has not been sent >> $LOGFILE;;
        $pay_pattern)        lftp -c "open -u $pay_user,$pay_pass $FTP_SRV; put -O / $RES" && mv $RES $ARC_DIR && echo $(/bin/date +%D\ %H:%M:%S) INFO File $FILENAME $FILESIZE has been sent successfully >> $LOGFILE || echo $(/bin/date +%D\ %H:%M:%S) ERROR File $FILENAME $FILESIZE has not been sent >> $LOGFILE;;
        $dict_pattern)       lftp -c "open -u $dict_user,$dict_pass $FTP_SRV; put -O / $RES" && mv $RES $ARC_DIR && echo $(/bin/date +%D\ %H:%M:%S) INFO File $FILENAME $FILESIZE has been sent successfully>> $LOGFILE || echo $(/bin/date +%D\ %H:%M:%S) ERROR File $FILENAME $FILESIZE has not been sent >> $LOGFILE;;
        *)                   echo $(/bin/date +%D\ %H:%M:%S) WARN File $FILENAME $FILESIZE does not match any pattern! >> $LOGFILE;;
    esac
done
