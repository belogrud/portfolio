#
#	https://gist.github.com/melvincabatuan/db38308697faf6e24cb0
#
#	In according this article I've tested what contain described variable at server, where yum works correct.
#	As I've seen - it contain nothing. It was not defined.
#
[root@m1-informatica01p tmp]# echo $LD_LIBRARY_PATH

[root@m1-informatica01p tmp]#

#
#	But at server, where we have troubles, we see that this variable is defined.
#	And after this variable have cleaned - yum starts working well.
