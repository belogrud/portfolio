#   Author of this task want to stop generation application crash dumps.
#   It's not a operation system core dumps. I asked author by phone about it.

................................................................................

[root@vm-insite04p ~]# cat /etc/system-release
CentOS Linux release 7.3.1611 (Core)
[root@vm-insite04p ~]#

................................................................................


#   https://access.redhat.com/solutions/4896
#   On this web page I found follow:
#
#   For Red Hat Enteprise Linux 7
#
#   The limit is set by systemd, and the following setting in /etc/systemd/system.conf can be set it as unlimited.
#
#   Raw
#   DefaultLimitCORE=infinity
#   Reboot the system

#   This means, I can use same option to turn it back to default (disabled) state.


................................................................................

[root@vm-insite04p ~]# vim +view /etc/systemd/system.conf
...
#DefaultLimitDATA=
#DefaultLimitSTACK=
DefaultLimitCORE=infinity
#DefaultLimitRSS=
#DefaultLimitNOFILE=
...

................................................................................

#
#   To be sure, I've seen same option at other server with rhel 7 installed.
#
[bsv@ds-pr-iris12p ~]$ awk '/DefaultLimitCORE/{print}' /etc/systemd/system.conf
#DefaultLimitCORE=
[bsv@ds-pr-iris12p ~]$

