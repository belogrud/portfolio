#	I have used command line from different sources. I have no full logs of upgrade process for all servers in hq-msk-gp-tst GreenPlum contour. But I have used same commands to update all servers that were updated. It looks similar, only server's prompt differ.

#	It was updated some of important packages that relates with all entire upgrade process.
[root@ds-gp-tst-smdw ~]# for var1 in sdw{2..8} ; do ssh -t root@${var1} "( hostname ; yum update subscription-manager yum )" ; done
[root@ds-gp-tst-smdw ~]# for var1 in sdw{2..8} ; do ssh -t root@${var1} "( hostname ; yum install yum-plugin-downloadonly )" ; done

#	All servers were registered into RHN with follow parameters.
[root@ds-gp-tst-smdw ~]# for var1 in sdw{3..8} ; do ssh -t root@${var1} "( hostname ; read -s -p \"Enter RHN Password: \" RHN_PASSWORD ; subscription-manager register --username=our_user_name --password=\$RHN_PASSWORD --name=ds-gp-tst-\$(hostname) --force --proxy=vm-vol-nag3.tcsbank.ru:3128 --auto-attach )" ; done

#	All necessery packages were downloaded to local yum cache. It takes time at this moment, but in future when we will start OS upgrade process it save our time very much.
[root@ds-gp-tst-smdw ~]# for var1 in sdw{2..8} ; do ssh -t root@${var1} "( hostname ; yum -y update --downloadonly --disablerepo="*" --enablerepo=rhel-6-server-rpms )" ; done

#	Here I have prepared simulateous update process on all servers with the screen utility.
#	I have created screen session on all servers.
#	This command was used for update all servers on each of them. It was run it under all existed screen sessions.
yum -y update --disablerepo="*" --enablerepo=rhel-6-server-rpms

