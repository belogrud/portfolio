
action= configure
method= custom   

controller= all

readcache= 10
writecache= 90

rebuildpriority= medium
expandpriority= medium

surfacescanmode= idle
surfacescandelay= 15

drivewritecache= enabled
nobatterywritecache= disabled

array= next
drive= *
logicaldrive= next
raid= 5
; I'm not sure about next option. I hope it will be universal for most cases. Even if capacity is less than 2TB.
size= maxmbr
caching= enabled

